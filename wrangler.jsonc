{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "treasure-chess",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "ChessRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChessRoom"] }]
}
